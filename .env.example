# API key that HappyRobot uses to call our endpoints
API_KEY=change-me-to-a-secret-key

# FMCSA QCMobile API key (free from https://mobile.fmcsa.dot.gov/)
FMCSA_WEB_KEY=your-fmcsa-web-key-here

# HappyRobot API key (from app.happyrobot.ai)
HAPPYROBOT_API_KEY=your-happyrobot-api-key-here

# Server
HOST=0.0.0.0
PORT=8000
